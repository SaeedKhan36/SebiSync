# Worker environment. Copy to apps/worker/.env for local development.
# In production these are set in the Vercel project settings, never committed —
# .env is gitignored and must stay that way.

# ---------------------------------------------------------------- required ---

# Postgres (Neon). Local dev reads this from packages/db/.env instead, which
# server.ts loads explicitly; set it here only if you are not using that file.
# In production use Neon's POOLED host — the worker opens a connection per
# request and will exhaust a direct endpoint.
DATABASE_URL=

# Gemini. Used by the extraction agent (gemini-2.5-flash), by embedding
# (gemini-embedding-001), and by PDF parsing — scanned pages are OCRed by
# sending the PDF straight to Gemini, so no separate OCR service is needed.
GEMINI_API_KEY=

# Clerk (authentication).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Cloudflare R2 — stores uploaded circular PDFs and evidence files.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------------------------------------------------------------- optional ---

# Comma-separated CORS allowlist for the frontend. Defaults to
# http://localhost:3000. Outside production, any loopback port is also accepted
# so a shifted Vite port cannot silently break every tRPC call.
# In production this MUST list your Vercel URL or the whole app fails with an
# opaque "Failed to fetch".
#
# The FIRST entry is also treated as the canonical public origin, used to build
# the gap links inside notification emails — so put production first, previews
# after.
WEB_ORIGIN=http://localhost:3000

# Port to listen on for the long-running local/Docker server. Unused on Vercel.
PORT=8787

# Guards POST /internal/detect-gaps. Without it the route returns 401 to
# everyone, which is a safe default. Generate a fresh value for production.
INTERNAL_API_SECRET=

# Gap notification email. With no RESEND_API_KEY, notifyGap is a no-op that
# returns 0 recipients — gap detection itself still works and notifiedAt stays
# null so the send can be retried. OWNER_EMAIL overrides the Clerk member
# lookup entirely, which is what you want on a Resend sandbox account.
RESEND_API_KEY=
OWNER_EMAIL=
NOTIFY_FROM_EMAIL=

# Trigger.dev runs the checklist fan-out on publish. Without these, publish
# still succeeds and degrades to fanOutStatus FAILED with an explanatory error.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Cron expression for scheduled gap detection.
GAP_DETECTION_CRON=*/5 * * * *
