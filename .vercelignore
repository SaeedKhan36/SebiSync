# Trims the source upload for BOTH Vercel projects (web and worker). Nothing
# here is needed to build either one — the build runs `bun install` and the
# bundlers from scratch on Vercel's side.
#
# Without this the CLI uploads ~100 MB of docs and slides on every deploy,
# which is slow enough to look like a hang.

# Build output — regenerated on Vercel, never uploaded.
dist
.output
.turbo
.vercel/output

# Not part of any build.
docs
*.pptx
*.log

# The docling sidecar deploys to Render, not Vercel. Its image pulls in
# paddleocr/paddlepaddle and has no business in either Vercel project.
services/docling-sidecar

# Python leftovers, in case the sidecar was ever run locally.
.venv
venv
__pycache__
